# =============================================================================
# Aether VoiceOps — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# Commented-out lines are safe to leave; the settings reader ignores them.
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_NAME=Aether VoiceOps API
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

PLATFORM_ADMIN_KEY=replace-with-a-long-random-string
TENANT_SECRET_KEY=replace-with-a-long-random-string

PUBLIC_BASE_URL=https://voice.aetherpro.us
NEXT_PUBLIC_API_BASE=https://voice.aetherpro.us/api/v1


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL / asyncpg)
# -----------------------------------------------------------------------------
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=voiceops
POSTGRES_HOST=acp-postgres
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# REDIS / VALKEY
# -----------------------------------------------------------------------------
REDIS_URL=redis://:replace-with-redis-password@acp-valkey:6379/0
REDIS_STREAMS_ENABLED=true

# Legacy global observability streams
REDIS_CALL_EVENT_STREAM=voiceops:call_events
REDIS_CALL_TRANSCRIPT_STREAM=voiceops:call_transcripts
REDIS_CALL_EXTRACTION_STREAM=voiceops:call_extractions
REDIS_CALL_ACTION_STREAM=voiceops:call_actions

# FSM per-call streams (Phase 3)
REDIS_CALL_STREAM_PREFIX=voice:calls
REDIS_CALL_STATE_HASH_PREFIX=voice:calls
REDIS_STREAM_MAXLEN=10000

# FSM consumer group names
REDIS_CG_STATE_CONTROLLER=voice:ctrl
REDIS_CG_ASR=voice:asr
REDIS_CG_TTS=voice:tts
REDIS_CG_LLM=voice:llm
REDIS_CG_AUDIT=voice:audit


# -----------------------------------------------------------------------------
# TWILIO
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_PHONE_NUMBER_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_RECOVERY_CODE=replace-if-needed


# -----------------------------------------------------------------------------
# AETHER VOICE GATEWAY (ASR + TTS)
# -----------------------------------------------------------------------------
AETHER_VOICE_HTTP_BASE=https://asr.aetherpro.us/api
AETHER_VOICE_WS_BASE=wss://asr.aetherpro.us

# Auth — set one of these (API key preferred)
AETHER_VOICE_API_KEY=replace-with-aether-voice-api-key
# AETHER_VOICE_BEARER_TOKEN=

# ASR defaults — overridable per agent via agent.policy_config.runtime
AETHER_VOICE_ASR_MODEL=auto
AETHER_VOICE_ASR_LANGUAGE=auto

# TTS defaults — overridable per agent via agent.policy_config.runtime
AETHER_VOICE_TTS_MODEL=kokoro_realtime
AETHER_VOICE_TTS_VOICE=af_bella
AETHER_VOICE_TTS_FORMAT=wav
AETHER_VOICE_TTS_SAMPLE_RATE=24000


# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible gateway)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_ENDPOINT=https://api.aetherpro.tech/v1/chat/completions
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=omnicoder
LLM_TIMEOUT_SECONDS=25
# Note: omnicoder and qwen3.5* require enable_thinking=false
# This is handled automatically by agent_runtime based on model name.


# -----------------------------------------------------------------------------
# TELEMETRY
# -----------------------------------------------------------------------------
CALL_LOG_ROOT=logs/calls
ENABLE_TRACING=false
LOG_LEVEL=info

# FSM_PIPELINE_ENABLED=falseHugging Face token (for model downloads if needed)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# FSM PIPELINE (Phase 3 migration)
# Set to true only after State Controller and consumers are deployed and tested.
# Default false = all calls use legacy VoiceSessionManager (safe for production).
# -----------------------------------------------------------------------------
FSM_PIPELINE_ENABLED=false
