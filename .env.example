APP_NAME=Aether VoiceOps API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PLATFORM_ADMIN_KEY=change-platform-key
TENANT_SECRET_KEY=replace-with-random-secret-seed

POSTGRES_USER=voiceops
POSTGRES_PASSWORD=voiceops
POSTGRES_DB=voiceops
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

AETHER_VOICE_HTTP_BASE=https://asr.aetherpro.us/api
AETHER_VOICE_WS_BASE=wss://asr.aetherpro.us
AETHER_VOICE_API_KEY=
AETHER_VOICE_BEARER_TOKEN=
AETHER_VOICE_ASR_MODEL=auto
AETHER_VOICE_ASR_LANGUAGE=auto
AETHER_VOICE_TTS_MODEL=kokoro_realtime
AETHER_VOICE_TTS_VOICE=af_sky
AETHER_VOICE_TTS_FORMAT=wav
AETHER_VOICE_TTS_SAMPLE_RATE=24000

LLM_PROVIDER=local
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ENABLE_TRACING=false
